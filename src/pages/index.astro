---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CalendlySection from '../components/CalendlySection.astro';
import BarrioTag from '../components/BarrioTag.astro';
import MaterialFormativo from '../components/MaterialFormativo.astro';
import CTABox from '../components/CTABox.astro';
import barriosData from '../data/barrios.json';
import serviciosData from '../data/servicios.json';

const faqItems = [
  {
    question: "¿Dónde está la consulta de nutrición en Getafe?",
    answer: "Nuestra consulta está en la Calle Zaragoza 1, Getafe. Es una ubicación céntrica con fácil acceso en transporte público (Cercanías Getafe Centro, Metro L12) y con aparcamiento en los alrededores."
  },
  {
    question: "¿Quiénes son los nutricionistas en Getafe?",
    answer: "En nuestra clínica de Getafe te atenderán Arancha Fontán, Ana Gómez, Alejandro Moraleja y Miriam, dietistas-nutricionistas colegiados con amplia experiencia en pérdida de grasa, nutrición clínica, nutrición deportiva y educación alimentaria."
  },
  {
    question: "¿Qué incluye la primera consulta de nutrición en Getafe?",
    answer: "Tu nutricionista realizará una entrevista detallada para conocer tu punto de partida: hábitos actuales, rutina diaria, posibles intolerancias y objetivos. En un máximo de 72 horas recibirás tu plan nutricional por email con menús adaptados a tus preferencias, recetas prácticas y lista de la compra."
  },
  {
    question: "¿Cada cuánto tiempo son las revisiones?",
    answer: "Las revisiones se programan cada 21 días. En cada una evaluaremos tu progreso, resolveremos dudas y ajustaremos el plan según tu evolución. Entre consultas tienes contacto directo por WhatsApp sin coste adicional."
  },
  {
    question: "¿Cuánto cuesta el nutricionista en Getafe?",
    answer: "Primera consulta: 55€ (incluye entrevista completa + plan nutricional + material formativo). Revisiones: 40€. Pack de primera consulta + 3 revisiones: 145€ — ahorras 30€ respecto a contratarlas por separado. Aceptamos efectivo, tarjeta y Bizum."
  },
  {
    question: "¿Necesitaré comprar suplementos o productos especiales?",
    answer: "No. Nuestros nutricionistas trabajan exclusivamente con planes basados en alimentación real adaptados a tu rutina. Sin suplementos, sin productos extras, sin gastos adicionales. Solo comida de verdad."
  },
  {
    question: "¿Cuál es el horario de la consulta en Getafe?",
    answer: "De lunes a viernes de 9:00 a 14:00 y de 15:30 a 21:00. Puedes reservar llamando al 655 37 80 68, por WhatsApp al mismo número o directamente en el calendario online de esta página."
  },
  {
    question: "¿Ofrecéis consulta de nutrición online desde Getafe?",
    answer: "Sí. Además de la consulta presencial en Getafe, ofrecemos atención online por videollamada con la misma calidad, plan personalizado y seguimiento continuo. Ideal si no puedes desplazarte o vives fuera de la zona."
  },
  {
    question: "¿Tenéis experiencia con nutrición deportiva en Getafe?",
    answer: "Sí. Nuestro equipo trabaja con deportistas de todas las disciplinas: running, CrossFit, pádel, fútbol, ciclismo, natación y más. Adaptamos la alimentación a tus entrenamientos, competiciones y objetivos de rendimiento."
  },
  {
    question: "¿Puedo acudir al nutricionista en Getafe si tengo alguna patología?",
    answer: "Por supuesto. Trabajamos con diabetes tipo 2, colesterol alto, hipertensión, SOP, problemas digestivos (SIBO, colon irritable, intolerancias), menopausia y más. Nos coordinamos con tu médico si es necesario."
  }
];

const testimonials = [
  {
    quote: "El equipo de Getafe me ha cambiado la vida. En tres meses he aprendido a cocinar sano, a planificar mis comidas y he perdido 8 kilos sin pasar hambre.",
    author: "Marta R.",
    rating: 5
  },
  {
    quote: "Me encanta que puedo seguir comiendo fuera sin agobiarme. Es un enfoque muy flexible y realista, nada que ver con las dietas que había hecho antes.",
    author: "Carlos G.",
    rating: 5
  },
  {
    quote: "Después de años probando dietas por mi cuenta, por fin alguien me ha enseñado a entender la nutrición. Los dossiers formativos son un regalo.",
    author: "Laura P.",
    rating: 5
  },
  {
    quote: "Trabajo a turnos y siempre me resultaba imposible organizarme. Aquí me han dado un plan que encaja perfectamente con mis horarios rotativos.",
    author: "Javier M.",
    rating: 5
  },
  {
    quote: "No solo he bajado de peso, tengo más energía que nunca. La atención entre consultas por WhatsApp es un puntazo.",
    author: "Sandra T.",
    rating: 5
  },
  {
    quote: "Desde la primera consulta me sentí cómodo. Te explican todo con mucha claridad, sin juzgar. Ojalá hubiera venido antes.",
    author: "Roberto F.",
    rating: 5
  },
  {
    quote: "Por fin he entendido por qué no conseguía resultados. Me lo explicaron con paciencia y sin tecnicismos. Totalmente recomendable.",
    author: "Ana M.",
    rating: 5
  },
  {
    quote: "Lo mejor es que no te dan una dieta genérica. Todo está pensado para tu situación real: tu trabajo, tu familia, tus gustos.",
    author: "Pedro L.",
    rating: 5
  },
  {
    quote: "Llevaba años intentándolo sola y en tres meses aquí he avanzado más que en cinco años. El material formativo es espectacular.",
    author: "Carmen S.",
    rating: 5
  },
  {
    quote: "Fuimos mi pareja y yo juntos y los dos estamos encantados. Nos han enseñado a planificar las cenas y a disfrutar de los fines de semana sin culpa.",
    author: "David y Lucía",
    rating: 5
  },
  {
    quote: "Me han reconciliado con la comida. Antes me sentía culpable por todo, ahora disfruto comiendo bien y mi ansiedad ha desaparecido.",
    author: "Elena R.",
    rating: 5
  },
  {
    quote: "Fui por colesterol alto y no solo me han normalizado las cifras: he aprendido a alimentarme de verdad. Un diez.",
    author: "Francisco J.",
    rating: 5
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthBusiness",
  "name": "Nutricionista en Getafe — Arancha Fontán, Ana Gómez, Alejandro Moraleja y Miriam",
  "description": "Consulta de nutrición en Getafe. Dietistas-nutricionistas colegiados especializados en pérdida de peso, nutrición deportiva, salud digestiva y hormonal.",
  "url": "https://nutricionista.io/nutricionista-en-getafe",
  "telephone": "+34655378068",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Zaragoza, 1",
    "addressLocality": "Getafe",
    "addressRegion": "Madrid",
    "postalCode": "28901",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.3050,
    "longitude": -3.7300
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "14:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "15:30",
      "closes": "21:00"
    }
  ],
  "priceRange": "40€ - 145€",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "52"
  }
};
---

<BaseLayout
  title="Nutricionista en Getafe | Calle Zaragoza 1 · Primera consulta 55€"
  description="Nutricionistas colegiados en Getafe. Planes personalizados para perder peso, nutrición deportiva, salud digestiva y hormonal. Calle Zaragoza 1. Primera consulta 55€. Reserva hoy."
  canonical="/nutricionista-en-getafe"
  schema={faqSchema}
>
  <Nav slot="nav" />

  <!-- Schema LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- 1. HERO — fotos equipo + vídeo vertical -->
  <Hero
    name="Nutricionista en Getafe"
    role="Tu cambio empieza aquí"
    showVideo={true}
    location="Calle Zaragoza 1 · Getafe"
    description=""
    benefits={[]}
  />

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- 2. INTRO SEO — Texto largo para posicionamiento -->
  <section class="section" id="nutricionista-getafe">
    <div class="container">
      <div class="seo-intro">
        <h2 class="section-title">Tu nutricionista en Getafe: un equipo que te acompaña de verdad</h2>
        <div class="seo-intro__text">
          <p><strong>Somos Arancha, Ana, Alejandro y Miriam.</strong> Formamos parte de un equipo de dietistas-nutricionistas con más de 7 años de experiencia atendiendo pacientes en el sur de Madrid. Tenemos consultas en <strong>Getafe, Alcorcón, Fuenlabrada, Leganés y Móstoles,</strong> y aplicamos un método de trabajo que hemos ido perfeccionando a lo largo de estos años.</p>
          <p>Si buscas un <strong>nutricionista en Getafe</strong> que se tome el tiempo de escucharte, entienda tu situación y diseñe un plan que encaje en tu día a día, has llegado al lugar indicado. No trabajamos con dietas restrictivas ni planes genéricos. Cada persona tiene unas necesidades distintas y su alimentación debe reflejarlo.</p>
          <p>Nuestro método se sustenta en tres pilares: <strong>alimentación real</strong> (comida de verdad, sin sustitutivos ni batidos), <strong>educación nutricional</strong> (que comprendas el porqué de cada decisión) y <strong>acompañamiento constante</strong> (estamos contigo entre consultas, no solo durante ellas).</p>
          <p style="font-weight: 700; color: var(--text);">Sigue leyendo y descubre exactamente cómo podemos ayudarte.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROCESO — ¿Cómo funciona? -->
  <section class="section section--warm" id="proceso">
    <div class="container">
      <h2 class="section-title">¿Cómo es el proceso?</h2>
      <div class="proceso-grid">
        <div class="proceso-card">
          <div class="proceso-icon">📋</div>
          <h3>Primera consulta</h3>
          <p>Analizamos tu situación actual en profundidad, completamos un cuestionario personalizado y definimos la estrategia más adecuada para tu caso concreto.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📩</div>
          <h3>Recibes tu plan</h3>
          <p>En un máximo de 72 horas tendrás tu plan nutricional por correo electrónico. A partir de ese momento puedes contactarnos para cualquier duda.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📊</div>
          <h3>Consultas de seguimiento</h3>
          <p>Cada 21 días evaluamos tu progreso, ajustamos el plan según tu evolución y te entregamos material formativo adicional para que sigas aprendiendo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PRECIOS -->
  <section class="section" id="precios">
    <div class="container">
      <h2 class="section-title">Precios: Nutricionista en Getafe</h2>
      <p class="section-sub">Elige la opción que mejor se adapte a ti.</p>

      <div class="pricing-row">
        <!-- Sesión individual -->
        <div class="price-basic">
          <div class="price-basic-label">Sesión individual</div>
          <div class="price-basic-header">Primera consulta</div>
          <div class="price-basic-amount">55<span>€</span></div>
          <ul class="price-basic-list">
            <li>✓ Entrevista inicial completa</li>
            <li>✓ Plan nutricional personalizado</li>
            <li>✓ Material de apoyo incluido</li>
          </ul>
          <div class="price-basic-revision">Revisiones: 40€/sesión</div>
          <a href="#reservar" class="price-basic-btn">PEDIR CITA</a>
        </div>

        <!-- Pack destacado -->
        <div class="price-pack">
          <div class="pack-badge-top">⭐ MÁS ELEGIDO — AHORRA 30€</div>
          <div class="pack-header">
            <h3>Pack: Primera + 3 Revisiones</h3>
            <p>Ahorra contratando tu bono</p>
          </div>
          <div class="pack-price-row">
            <div class="pack-old-price">175€</div>
            <div class="pack-new-price">145<span>€</span></div>
          </div>
          <div class="pack-savings">Ahorro de 30€ respecto a contratar por separado</div>
          <ul class="pack-features">
            <li>Incluye 4 sesiones completas</li>
            <li>Plan nutricional + ajustes continuos</li>
            <li>Soporte de dudas entre consultas</li>
            <li>Todo el material formativo</li>
            <li>Mayor compromiso, mejores resultados</li>
          </ul>
          <a href="#reservar" class="pack-btn">PEDIR CITA</a>
        </div>
      </div>

      <!-- Nota parejas -->
      <div class="parejas-note">
        <p class="parejas-title">💑 <strong>Consultas para parejas</strong></p>
        <p class="parejas-detail">Primera consulta pareja: 100€ · Revisión pareja: 55€ · Bono 4 consultas parejas: 220€</p>
        <a href="#reservar" class="parejas-btn">Reservar cita para 2 personas</a>
      </div>
    </div>
  </section>

  <!-- 5. UBICACIÓN + MAPA -->
  <section class="section section--alt" id="ubicacion">
    <div class="container">
      <h2 class="section-title">¿Dónde está nuestra consulta en Getafe?</h2>
      <div class="location-box">
        <div class="location-info">
          <div class="location-row">
            <span class="location-icon">📍</span>
            <div>
              <strong>Dirección</strong>
              <span>Calle Zaragoza 1, 28901 Getafe</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">📞</span>
            <div>
              <strong>Teléfono</strong>
              <span><a href="tel:+34655378068">655 37 80 68</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">💬</span>
            <div>
              <strong>WhatsApp</strong>
              <span><a href="https://wa.me/34655378068?text=Hola%2C%20quiero%20informarme%20sobre%20Getafe" target="_blank" rel="noopener">655 37 80 68</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🕐</span>
            <div>
              <strong>Horarios</strong>
              <span>Lunes a Viernes: 9:00–14:00 / 15:30–21:00</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🚇</span>
            <div>
              <strong>Cómo llegar</strong>
              <span>Cercanías Getafe Centro · Metro L12 · Parking cercano</span>
            </div>
          </div>
          <div class="location-actions">
            <a href="tel:+34655378068" class="loc-btn loc-btn--primary">Llamar al 655 37 80 68</a>
            <a href="https://wa.me/34655378068?text=Hola%2C%20quiero%20informarme%20sobre%20Getafe" target="_blank" rel="noopener" class="loc-btn loc-btn--outline">Enviar WhatsApp</a>
          </div>
        </div>
        <div class="location-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3013.5!2d-3.7300!3d40.3050!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4187e7e2b7f5d5%3A0x1234567890abcdef!2sC.%20Zaragoza%2C%201%2C%2028901%20Getafe!5e0!3m2!1ses!2ses!4v1710000000000!5m2!1ses!2ses"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Nutricionista en Getafe — Calle Zaragoza 1"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. RESERVA CITA (Calendly con tabs) -->
  <CalendlySection />

  <!-- 7. FAQ -->
  <section class="section section--warm" id="faq">
    <div class="container">
      <h2 class="section-title">Preguntas frecuentes sobre el nutricionista en Getafe</h2>
      <p class="section-sub">¿Tienes alguna duda? Puede que esta sección despeje alguna de ellas:</p>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- CTA intermedio -->
  <CTABox
    title="¿Preparado/a para mejorar tu alimentación?"
    description="Reserva tu primera consulta con nuestros nutricionistas en Getafe. 55€, sin compromiso. Llama al 655 37 80 68 o escríbenos por WhatsApp."
    ctaText="Reservar mi cita"
    ctaHref="#reservar"
    variant="trust"
  />

  <!-- 8. QUÉ NOS DIFERENCIA -->
  <section class="section section--alt" id="diferencia">
    <div class="container">
      <h2 class="section-title">Por qué elegir a nuestros nutricionistas en Getafe</h2>
      <div class="diff-text">
        <p>Nutricionista.io empezó en 2017 como el proyecto de un solo profesional. Hoy <strong>somos un equipo de 20 dietistas-nutricionistas</strong> repartidos por toda España, con consultas presenciales en Getafe, Alcorcón, Fuenlabrada, Leganés y Móstoles.</p>
        <p>A lo largo de estos años hemos perfeccionado un sistema de trabajo enfocado en lo que realmente genera resultados: <strong>alimentación real, educación nutricional y acompañamiento constante.</strong> Sin atajos, sin promesas vacías.</p>
        <p>Cuando acudes a nuestro nutricionista en Getafe no solo recibes un plan alimentario personalizado. Te proporcionamos las herramientas necesarias para que los cambios perduren:</p>
      </div>

      <!-- Tres pilares destacados -->
      <div class="pilares-grid">
        <div class="pilar-card">
          <div class="pilar-num">1</div>
          <h3>Material formativo en cada revisión</h3>
          <p>Dossiers prácticos sobre etiquetado, metabolismo, pérdida de grasa, adherencia y más. No solo te damos un plan: te enseñamos el porqué de cada decisión.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">2</div>
          <h3>Área de Pacientes exclusiva</h3>
          <p>Vídeos, guías, infografías, calculadoras y recetarios. Más de 110 recursos para que avances hacia la autonomía nutricional.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">3</div>
          <h3>Comunidad de WhatsApp</h3>
          <p>Recetas semanales, productos recomendados, ideas prácticas y soporte entre consultas. El proceso no se detiene cuando sales de la clínica.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. MATERIAL FORMATIVO -->
  <section class="section" id="material">
    <div class="container">
      <h2 class="section-title">Material formativo que recibirás</h2>
      <p class="section-sub">En cada revisión con tu nutricionista en Getafe recibirás un nuevo dossier. Temas como el etiquetado, pérdida de grasa, metabolismo y adherencia:</p>
      <MaterialFormativo />
    </div>
  </section>

  <!-- 10. ¿PARA QUIÉN ES? — SEO content -->
  <section class="section section--warm" id="para-quien">
    <div class="container">
      <h2 class="section-title">¿A quién va dirigido nuestro servicio de nutrición en Getafe?</h2>
      <p class="section-sub">Atendemos a perfiles muy diversos. Si te identificas con alguna de estas situaciones, podemos ayudarte:</p>
      <div class="para-quien-grid">
        <div class="para-quien-card">
          <span class="para-quien-icon">⚖️</span>
          <h3>Quieres perder peso de verdad</h3>
          <p>Has probado varias dietas sin resultados duraderos. Necesitas un enfoque personalizado que se adapte a tu rutina, sin pasar hambre y sin efecto rebote.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🏃</span>
          <h3>Haces deporte y quieres rendir más</h3>
          <p>Corres, vas al gimnasio, juegas al pádel o practicas CrossFit. Tu alimentación debería estar a la altura de tu entrenamiento para optimizar rendimiento y recuperación.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🩺</span>
          <h3>Tienes una patología que mejorar</h3>
          <p>Diabetes tipo 2, colesterol alto, hipertensión, SOP, problemas digestivos, intolerancias... La alimentación es una herramienta terapéutica muy potente y podemos guiarte.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🔄</span>
          <h3>Quieres aprender a comer bien</h3>
          <p>No tienes un objetivo concreto de peso, pero sabes que tu alimentación podría mejorar. Quieres entender qué comes, organizarte mejor y sentirte con más energía.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. TESTIMONIOS -->
  <section class="section section--alt" id="testimonios">
    <div class="container">
      <div class="testi-header">
        <span class="testi-stars-big">★★★★★</span>
        <h2 class="section-title">Lo que dicen nuestros pacientes en Getafe</h2>
        <p class="section-sub">Estas son solo algunas valoraciones. Puedes encontrar más en nuestros perfiles de Google.</p>
      </div>
      <div class="resenas-grid">
        {testimonials.map(testimonial => (
          <TestimonialCard
            quote={testimonial.quote}
            author={testimonial.author}
            rating={testimonial.rating}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 12. SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <h2 class="section-title">Servicios de nutrición en Getafe</h2>
      <p class="section-sub">Sea cual sea tu objetivo, nuestros nutricionistas en Getafe tienen un plan adaptado a ti. Cada consulta es diferente porque cada persona es diferente.</p>
      <div class="servicios-grid">
        {serviciosData.map(servicio => (
          <ServiceCard
            emoji={servicio.emoji}
            title={servicio.title}
            description={servicio.shortDesc}
            href={`/${servicio.slug}`}
          />
        ))}
        <ServiceCard
          emoji="💻"
          title="Consulta online"
          description="La misma calidad desde casa. Videollamada, plan personalizado y seguimiento completo"
          href="/nutricionista-online"
        />
      </div>
    </div>
  </section>

  <!-- 13. BARRIOS (SEO local) -->
  <section class="section section--alt" id="barrios">
    <div class="container">
      <h2 class="section-title">Nutricionista cerca de ti en Getafe</h2>
      <p class="section-sub">Atendemos a pacientes de todos los barrios de Getafe. Nuestra consulta está en el centro, a pocos minutos de cualquier punto del municipio.</p>
      <div class="barrios-grid">
        {barriosData.map(barrio => (
          <BarrioTag name={barrio.name} href={`/${barrio.slug}`} />
        ))}
