---
interface Props {
  type: 'arancha' | 'ana' | 'alejandro' | 'miriam' | 'arancha-parejas' | 'ana-parejas' | 'alejandro-parejas' | 'miriam-parejas';
}

const { type } = Astro.props;

const urls: Record<string, string> = {
  'arancha': 'https://calendly.com/aranchafontannutricion/primera-consulta-getafe?hide_event_type_details=1&hide_gdpr_banner=1',
  'ana': 'https://calendly.com/nutricionanagomez/primera-consulta?hide_event_type_details=1&hide_gdpr_banner=1',
  'alejandro': 'https://calendly.com/almoranutri/primera-consulta?hide_event_type_details=1&hide_gdpr_banner=1',
  'miriam': 'https://calendly.com/nutricionistaenalcala/primera-consulta-getafe?hide_event_type_details=1&hide_gdpr_banner=1',
  'arancha-parejas': 'https://calendly.com/aranchafontannutricion/primera-consulta-pareja-getafe?hide_event_type_details=1&hide_gdpr_banner=1',
  'ana-parejas': 'https://calendly.com/nutricionanagomez/primera-consulta-pareja?hide_event_type_details=1&hide_gdpr_banner=1',
  'alejandro-parejas': 'https://calendly.com/almoranutri/primera-consulta-clon?hide_event_type_details=1&hide_gdpr_banner=1',
  'miriam-parejas': 'https://calendly.com/nutricionistaenalcala/primera-consulta-2-personas-getafe?hide_event_type_details=1&hide_gdpr_banner=1',
};

const calendlyUrl = urls[type];
---

<div class="calendly-embed" data-calendly-url={calendlyUrl}>
  <div class="calendly-placeholder">
    <div class="calendly-placeholder__content">
      <p>Cargando calendario de reservas...</p>
    </div>
  </div>
  <div
    class="calendly-inline-widget"
    data-url={calendlyUrl}
    style="min-width:280px;height:700px;display:none;"
  ></div>
</div>

<script>
  let calendlyLoaded = false;

  function loadCalendly() {
    if (calendlyLoaded) return;
    calendlyLoaded = true;

    const script = document.createElement('script');
    script.src = 'https://assets.calendly.com/assets/external/widget.js';
    script.async = true;
    document.head.appendChild(script);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const embeds = document.querySelectorAll('.calendly-embed');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const placeholder = entry.target.querySelector('.calendly-placeholder') as HTMLElement;
          const widget = entry.target.querySelector('.calendly-inline-widget') as HTMLElement;

          loadCalendly();

          setTimeout(() => {
            if (placeholder && widget) {
              placeholder.style.display = 'none';
              widget.style.display = 'block';
            }
          }, 500);

          observer.unobserve(entry.target);
        }
      });
    }, {
      rootMargin: '200px'
    });

    embeds.forEach((embed) => observer.observe(embed));
  });
</script>

<style>
  .calendly-embed {
    width: 100%;
    margin: var(--spacing-sm) 0;
  }

  .calendly-placeholder {
    min-width: 280px;
    height: 700px;
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .calendly-placeholder__content {
    text-align: center;
    color: var(--color-text-secondary);
  }

  .calendly-placeholder__content p {
    font-size: 1.1rem;
    margin: 0;
  }
</style>
